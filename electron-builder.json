{
  "appId": "id.mamsaka.vpnwireguardasli",
  "productName": "VPN WireGuard Asli",
  "directories": { "output": "dist-electron-v12" },
  "files": [
    "electron/**/*",
    ".next/standalone/**/*",
    ".next/static/**/*",
    "public/**/*",
    "configs/CONTOH.local-1.conf.txt",
    "package.json"
  ],
  "extraResources": [
    { "from": "configs", "to": "configs", "filter": ["CONTOH*"] }
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "artifactName": "VPN-WireGuard-Asli-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "VPN WireGuard Asli"
  }
}
